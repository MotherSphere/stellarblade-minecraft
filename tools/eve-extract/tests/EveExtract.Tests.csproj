<Project Sdk="Microsoft.NET.Sdk">
  <!-- EveExtract's argument and input checks on synthetic trees, and its CRC32.cs, without CUE4Parse or game data.
       tools/check.py runs it; exit code 0 when every check passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Inputs.cs" />
    <Compile Include="../CRC32.cs" />
    <!-- CRC32.cs's, the version CUE4Parse pins. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
  </ItemGroup>
</Project>
